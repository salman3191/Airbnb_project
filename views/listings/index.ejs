<% layout("/layouts/boilerplate") %>
<style>
#filters{
  display: flex;
  flex-wrap: wrap;

}
.filter{
margin-top: 2rem;
margin-right: 2rem;
text-align: center;
opacity: 0.7;
}
.filter:hover{
  opacity: 1;
  cursor: pointer;
}
.filter,p{
  font-size: 0.8rem;
}
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>

  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>


  <div class="filter">
    <div><i class="fa-solid fa-city"></i></i></div>
    <p>Iconic Cities</p>
  </div>


  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></i></div>
    <p>Mountains</p>
  </div>

  <div class="filter">
    <i class="fa-brands fa-fort-awesome"></i>
    <p>Castles</p>
  </div>

  <div class="filter">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Amazing Pools</p>
  </div>

  
</div>

<div class="row row-cols-lg-4 row-cols-md-2 mt-3">
  <%for(listings of allListings){%>

  <a href="/listings/<%= listings._id %>" class="listing-link">
    <div class="card listin-card" style="width: 20rem">
      <img
        src="<%=listings.image.url%>"
        class="card-img-top"
        alt="listing image"
        style="height: 20rem"
      />
      <div class="card-img-overlay">abc</div>
      <div class="card-body">
        <p class="card-text">
          <b><%= listings.title %></b><br />&#8377;<%=
          listings.price.toLocaleString("en-IN") %>/night
        </p>
      </div>
    </div>
  </a>
  <%}%>
</div>
