<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-3 ">
    <h1><b><%= data.title %></h1>
      </div>
    <div class="card col-6 offset-3 show-card">
      <img
        src="<%= data.image.url %>"
        class="card-img-top show-img"
        alt="listing-image"
      />
      <div class="card-body">
       

        <p class="card-text">
          <%= data.description %> <br />
          &#8377;<%= data.price.toLocaleString("en-IN") %> <br />
          <%= data.location %>
          <br />
          <%= data.country %>
        </p>
      </div>
      <br>
      <form method="post" action="/listings/<%= data.id %>?_method=DELETE">
      <a href="/listings/<%= data.id %>/edit" class="btn edit-btn">Edit</a>
      <button class="btn delete-btn">Delete</button>
    </form>
    </div>

    
  
 <div class="col-8 offset-3 mb-3">
  <hr>

  <h4>leave a Review</h4>
  <form action="">
    <div>
      <label for="rating" class="form-label">Rating</label>
      <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]">
    </div>
    <div>
      <label for="comment" class="form-label">Comments</label>
      <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" style="border-radius:3px border-color=black"></textarea>
    </div>
    <br>
    <button class="btn btn-outline-dark" >Submit</button>
  </form>
 </div>


</div>
